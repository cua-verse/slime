{
  "name": "Slime",
  "image": "slimerl/slime:latest",
  "mounts": [
    "source=${localEnv:HOME}/.netrc,target=/root/.netrc,type=bind"
  ],
  "runArgs": [
    "--gpus", "all",
    "--ipc=host",
    "--shm-size=16g",
    "--ulimit", "memlock=-1",
    "--ulimit", "stack=67108864"
  ],
  "workspaceFolder": "/workspaces/slime",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/slime,type=bind",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python",
        "python.analysis.extraPaths": [
          "/root/Megatron-LM",
          "/sgl-workspace/sglang/python",
          "/workspaces/slime"
        ]
      }
    }
  },
  "postCreateCommand": "pip install -e /workspaces/slime --no-deps 2>/dev/null || true",
  "remoteUser": "root"
}
